{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/signup",
      "destination": "/login.html"
    },
    {
      "source": "/signup.html",
      "destination": "/login.html"
    },
    {
      "source": "/shared-filter/:slug",
      "destination": "/shared-filter.html?slug=:slug"
    }
  ]
}
